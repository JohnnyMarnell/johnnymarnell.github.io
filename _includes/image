{%- comment -%}
  An image tile in a .gallery grid.

  Parameters
    src          full path, or a fragment fuzzy-matched against /img/*
    orientation  "portrait" | "landscape"  (default: detected at runtime)
    portrait     legacy boolean alias for orientation="portrait"
    aspect       "W:H" override for the tile
    alt          accessible label / caption

  Orientation and aspect normally come from _data/media.yml (`just media`),
  which reads them out of the JPEG header — so the tile is the right shape in
  the first paint, with no reflow.

  Failing that (an image added but not yet probed), the tile is marked
  data-orientation-auto and gallery.js corrects it from naturalWidth/
  naturalHeight once decoded — right, but one frame late.

  data-slug is the handle a shareable URL carries (/led/?m=<slug>, see
  gallery.js), derived from the filename: IMG_0328.HEIC.jpg -> img-0328. It is
  therefore only as stable as the filename, which is the price of not making
  the author write one by hand; gallery.js falls back to the tile index for a
  slug it cannot resolve, so a renamed file degrades to "opens the gallery"
  rather than to a broken page.
{%- endcomment -%}

{%- assign known = "src,orientation,portrait,aspect,alt" | split: "," -%}
{%- assign unknown = "" -%}
{%- for pair in include -%}
  {%- unless known contains pair[0] -%}
    {%- assign unknown = unknown | append: pair[0] | append: " " -%}
  {%- endunless -%}
{%- endfor -%}

{%- assign img_path = "" -%}
{%- if include.src contains "/" or include.src contains "." -%}
  {%- assign img_path = include.src -%}
{%- else -%}
  {%- assign needle = include.src | downcase -%}
  {%- for file in site.static_files -%}
    {%- if file.path contains "/img/" -%}
      {%- assign name = file.name | downcase -%}
      {%- if name contains needle -%}
        {%- assign img_path = file.path -%}
        {%- break -%}
      {%- endif -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}

{%- if img_path == "" -%}
  {%- comment -%} Loud rather than silent: a missing image is a broken page. {%- endcomment -%}
  <a class="tile" data-tile data-kind="image" data-orientation="landscape" data-aspect="16:9"
     data-missing="{{ include.src | escape }}" href="#"
     aria-label="Missing image: {{ include.src | escape }}"></a>
{%- else -%}
  {%- assign alt = include.alt | default: "Photo" -%}
  {%- assign img_slug = img_path | split: "/" | last | split: "." | first | downcase | replace: "_", "-" -%}
  {%- assign known_image = site.data.media.images[img_path] -%}
  {%- if include.orientation == "portrait" or include.portrait -%}
    {%- assign orientation = "portrait" -%}
    {%- assign aspect = include.aspect | default: "3:4" -%}
    {%- assign auto = false -%}
  {%- elsif include.orientation == "landscape" -%}
    {%- assign orientation = "landscape" -%}
    {%- assign aspect = include.aspect | default: "16:9" -%}
    {%- assign auto = false -%}
  {%- elsif known_image -%}
    {%- assign orientation = known_image.orientation -%}
    {%- assign aspect = include.aspect | default: known_image.aspect -%}
    {%- assign auto = false -%}
  {%- else -%}
    {%- assign orientation = "landscape" -%}
    {%- assign aspect = include.aspect | default: "16:9" -%}
    {%- assign auto = true -%}
  {%- endif -%}

<a class="tile" data-tile data-kind="image"
   data-slug="{{ img_slug }}"
   data-orientation="{{ orientation }}" data-aspect="{{ aspect }}"
   data-caption="{{ alt | escape }}"
   style="--media-aspect: {{ aspect | replace: ':', ' / ' }}"
   {% if auto %}data-orientation-auto {% endif -%}
   {% if unknown != "" %}data-unknown-params="{{ unknown | strip }}" {% endif -%}
   href="{{ img_path | relative_url }}"
   aria-label="View photo: {{ alt | escape }}">
  <span class="tile__ambient" style="--poster: url('{{ img_path | relative_url }}')" aria-hidden="true"></span>
  <img class="tile__media" data-media src="{{ img_path | relative_url }}"
       alt="{{ alt | escape }}" loading="lazy" decoding="async">
</a>
{%- endif -%}
